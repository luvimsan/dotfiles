#!/usr/bin/env bash

file="$HOME/notes/vocab.txt"
mkdir -p "$(dirname "$file")"

word=$(dmenu -p "📖 Define:" < /dev/null) || exit 0

[[ -z "$word" || "$word" =~ [\/] ]] && notify-send -u critical -t 3000 "❌ Invalid input" && exit 0

# Datamuse API query (asks for definitions with 'def' sp=spelling)
query=$(curl -s --connect-timeout 5 --max-time 10 "https://api.datamuse.com/words?sp=$word&md=d")
[ $? -ne 0 ] && notify-send -u critical -t 3000 "⚠️ Connection error" && exit 1

# Extract definition using jq
def=$(echo "$query" | jq -r '.[0].defs[]?' 2>/dev/null)

[[ -z "$def" ]] && notify-send -u critical -t 3000 "❌ No definition found" && exit 0

notify-send -t 10000 "$word definitions:" "$def"
grep -qxF "$word" "$file" 2>/dev/null || echo "$word" >> "$file"
