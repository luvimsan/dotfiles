#!/usr/bin/env bash

SERVICE="$1"
[[ -z $SERVICE ]] && exit 1

PASS_PATH="accounts/$SERVICE"

# if pass show "accounts/$SERVICE" &>/dev/null; then
#     echo "Error: Entry '$PASS_PATH' already exists. Aborting to prevent overwrite."
#     exit 1
# fi

DOMAIN="luvimsan.dev"
SALT="$(openssl rand -hex 2)"

# pass generate "$PASS_PATH" 25 >/dev/null

EMAIL="$SERVICE-$SALT-acc@$DOMAIN"
PASSWORD=$(pass show "$PASS_PATH")

printf "%s\nUsername: %s\n" "$PASSWORD" "$EMAIL" | pass insert -m "accounts/$SERVICE"

